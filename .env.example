# ==========================================
# CobraDecision Environment Configuration
# ==========================================

# Server & Runtime Environment
# 'development' or 'production' (in production, secure session cookies are enforced)
NODE_ENV=production
PORT=3000
BASE_URL=http://localhost:3000

# Database Configuration
DATABASE_PATH=data/app.sqlite

# Authentication & Security
# Secret key used for signing JWT authentication tokens (generate a strong random string)
JWT_SECRET=your_generated_hex_string

# ALTCHA anti-spam / proof-of-work captcha HMAC signing key
ALTCHA_HMAC_SECRET=your_generated_hex_string

# Initial Super Admin Seed (optional)
# Automatically creates or promotes this user to Super Admin upon startup
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_this_secure_password_123

# VPS File Storage & Asset Uploads
# Local directory on disk where uploaded meeting images & presentations are saved
STORAGE_DIR=./public/uploads

# Public base URL where uploaded files are served
ASSET_BASE_URL=/uploads

# Logging Configuration
# Destination directory for structured module event logs (*.log)
LOG_DIR=./log

# Automated Daily Backup & FTP Storage Configuration
# Scheduled hour & minute for daily database snapshots (format: HH:mm)
BACKUP_TIME=03:30

# Local directory where automated database snapshots (.sqlite) are stored
BACKUP_LOCAL_DIR=./backups

# Enable remote FTP backup upload & automated retention rotation (true / false)
FTP_BACKUP_ENABLED=false

# Remote FTP server credentials & port (default port 21)
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=

# Remote directory on the FTP server to store database backups
FTP_REMOTE_DIR=/backups

# Maximum number of backup files to keep on the remote FTP server (default 3)
# When limit is reached, oldest backup is automatically pruned before uploading newest
FTP_BACKUP_RETENTION_COUNT=3

# Email & Mailer Configuration
# Gmail SMTP / App Password or custom domain SMTP (leave blank for local console/file fallback)
# Note: For Gmail, use 16-character Google App Password with 2-Step Verification
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CobraDecision <noreply@example.com>"
MEET_REMINDER_DAYS_BEFORE=1
MAILER_SCHEDULER_INTERVAL_MS=60000

# Telegram Mini App Configuration
# Bot token received from @BotFather for initData cryptographic verification
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

