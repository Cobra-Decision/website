# ==========================================
# CobraDecision Environment Configuration
# ==========================================

# Server & Runtime Environment
# 'development' or 'production' (in production, session cookies require HTTPS)
NODE_ENV=development
PORT=3000

# Authentication & Security
# Secret key used for signing JWT authentication tokens (generate a strong random string)
JWT_SECRET=v9R/m4Qz7LpK2xT8jN5wE1sY6bH3cM0fV+pD8gA4uKo=

# ALTCHA anti-spam / captcha HMAC signing key
ALTCHA_HMAC_SECRET=c8b9d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3

# Initial Super Admin Seed (optional)
# Automatically creates or promotes this user to Super Admin upon startup
SEED_ADMIN_EMAIL=rezishon@duck.com
SEED_ADMIN_PASSWORD=reza1381

# VPS File Storage & Asset Uploads
# Local directory on disk where uploaded meeting images are saved
STORAGE_DIR=./public/uploads

# Public base URL where uploaded files are served
ASSET_BASE_URL=/uploads
