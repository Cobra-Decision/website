# ALTCHA HMAC secret for challenge signing and verification
ALTCHA_HMAC_SECRET=replace-with-a-long-random-secret

# JWT signing secret
JWT_SECRET=replace-with-a-long-random-secret

# Optional: create one admin account during database initialization
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
