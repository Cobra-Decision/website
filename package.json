{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/ui/tailwind.css -o public/app.css --minify",
    "dev": "bun run build:css && bun --watch src/index.tsx",
    "start": "bun run build:css && bun src/index.tsx",
    "seed": "bun src/seed.ts",
    "test": "bun test",
    "check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "altcha": "^3.2.1",
    "altcha-lib": "^2.3.2",
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.0.0",
    "daisyui": "4.12.24",
    "tailwindcss": "3.4.17",
    "typescript": "^5.0.0"
  }
}
